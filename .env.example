APP_NAME="Controle Financeiro"
APP_ENV=local
APP_KEY=
# Em produção: APP_ENV=production e APP_DEBUG=false (nunca exponha erros detalhados).
APP_DEBUG=true
APP_URL=http://controle-financeiro-paola.test
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

CLINICA_NOME="Clínica"

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=controle_financeiro
# Use um usuário próprio do sistema, com permissão apenas neste banco (nunca o root em produção).
DB_USERNAME=controle_financeiro
DB_PASSWORD=
# Fuso fixo da conexão (horário de Brasília): mantém os horários certos mesmo com o servidor em UTC.
DB_TIMEZONE=-03:00

# Sessões no banco, criptografadas, expirando após 60 min sem uso.
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Em produção (HTTPS) use true para o cookie só trafegar criptografado.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="financeiro@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
